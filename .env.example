# Optional settings read by the example, benchmark and verification scripts. No secrets.
# Bun loads a local .env automatically; an empty value means "off". Copy only the lines you need.

# examples/server.ts listener port
PORT=8080

# scripts/bench.ts workload; delete BENCH_MODES to use the runtime-dependent default
BENCH_REQUESTS=4000
BENCH_CONCURRENCY=32
BENCH_ROUNDS=3
BENCH_MODES=native,live,immutable,api
BASELINE_PACKAGE_DIR=

# scripts/e2e.ts gates (make e2e sets REQUIRE_BUN and REQUIRE_BROWSERS itself)
REQUIRE_BUN=
REQUIRE_BROWSERS=
REQUIRE_UPSTREAM=
SYSTEM_CHROMIUM=

# Upstream package specs or absolute tarball paths, and an O11y fixture file
DEFUSS_RPC_PACKAGE=
DEFUSS_MCP_PACKAGE=
DEFUSS_O11Y_PACKAGE=
DEFUSS_O11Y_FIXTURE=

# scripts/offline-build.ts: explicit @types root for the labeled offline fallback build
NODE_TYPES_ROOT=
